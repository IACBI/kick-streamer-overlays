# Kick app credentials (client id and secret). Never commit.
AYARLAR.local.js

# Local relay access key, written by the relay on first start. Never commit.
AYARLAR.relay.js

# Environment files and key material. Never commit.
.env
.env.*
*.pem
*.key

# Local tooling output
node_modules/
*.log
qa-out/

# Built relay executables (npm run build:relay)
dist/

# Stream stats and OBS text labels, written by the relay
kick-relay-stats.json
kick-relay-stats.json.tmp
labels/

# Settings saved from the studio through the relay: the previous AYARLAR.js, and half-written files
AYARLAR.backup.js
AYARLAR*.tmp
